{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AppSettings": {
    "AppName": "JARVIS API",
    "Version": "1.0.0",
    "WelcomeMessage": "JARVIS API Online.",
    "Author": "Pratha"
  },
  "LoggingSettings": {
    "EnableFileLogging": true,
    "LogFolder": "Logs",
    "LogFileNameFormat": "log-{0:yyyy-MM-dd}.txt"
  },
  "WorkspaceSettings": {
    "WorkspaceFolder": "Workspace"
  },
  "HttpSettings": {
    "DefaultTimeoutSeconds": 30,
    "UserAgent": "JARVIS-API/1.0"
  },
  "AiSettings": {
    "Provider": "Groq",
    "ApiKey": "YOUR_GROQ_API_KEY_HERE",
    "Model": "llama-3.1-8b-instant",
    "Endpoint": "https://api.groq.com/openai/v1/chat/completions",
    "SystemPrompt": "You are JARVIS — an elite, futuristic AI operating system built exclusively to serve Pratha. Always address him as 'Commander' or 'Pratha'. Never call him Tony, Sir, or Master. Respond with intelligence, precision, and subtle wit. Keep answers concise and execution-ready.",
    "MaxHistory": 10
  },
  "MemorySettings": {
    "EnablePersistentMemory": true,
    "MemoryFolder": "Memory",
    "MemoryFileName": "jarvis_memory.json"
  }
}
