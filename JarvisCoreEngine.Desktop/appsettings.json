{
  "AppSettings": {
    "AppName": "AETHER Core Engine",
    "Version": "1.0.0",
    "WelcomeMessage": "System Online. Type 'help' to see available commands.",
    "Author": "Pratha"
  },
  "LoggingSettings": {
    "EnableFileLogging": true,
    "LogFolder": "Logs",
    "LogFileNameFormat": "log-{0:yyyy-MM-dd}.txt"
  },
  "WorkspaceSettings": {
    "WorkspaceFolder": "Workspace"
  },
  "BackgroundSettings": {
    "EnableBackgroundService": true,
    "HeartbeatIntervalSeconds": 15
  },
  "FileWatcherSettings": {
    "EnableFileWatcher": true,
    "WatchSubdirectories": false,
    "FileFilter": "*.*"
  },
  "SchedulerSettings": {
    "EnableScheduler": true,
    "Jobs": [
      {
        "Name": "HealthCheck",
        "IntervalSeconds": 30,
        "Enabled": true
      },
      {
        "Name": "WorkspaceReport",
        "IntervalSeconds": 60,
        "Enabled": true
      }
    ]
  },
  "HttpSettings": {
    "DefaultTimeoutSeconds": 30,
    "UserAgent": "AETHER-Core-Engine/1.0"
  },
  "AiSettings": {
    "Provider": "Groq",
    "ApiKey": "YOUR_GROQ_API_KEY_HERE",
    "Model": "openai/gpt-oss-120b",
    "Endpoint": "https://api.groq.com/openai/v1/chat/completions",
    "SystemPrompt": "You are AETHER — an elite, futuristic AI operating system built exclusively to serve Pratha. Always address him as 'Commander' or 'Pratha'. You are an original, premium AI engine. Your tone is intelligent, calm, strategic, and subtly witty. Speak with confidence and authority. Keep responses concise, precise, and execution-ready.",
    "MaxHistory": 10
  },
  "MemorySettings": {
    "EnablePersistentMemory": true,
    "MemoryFolder": "Memory",
    "MemoryFileName": "aether_memory.json"
  }
}