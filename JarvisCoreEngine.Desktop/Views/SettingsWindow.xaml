<Window x:Class="JarvisCoreEngine.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER Settings"
        Height="650" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFont}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Border CornerRadius="14"
            Background="{StaticResource JarvisBgGradient}"
            BorderBrush="{StaticResource AccentCyanBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#00E5FF" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚙ SETTINGS" 
                               FontSize="11" FontWeight="Light"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>

                    <Button Grid.Column="1" Content="✕" Width="36" Height="28" FontSize="13"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ===== HEADER ===== -->
            <Border Grid.Row="1" Background="#88111827" 
                    BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="0,0,0,1"
                    Padding="30,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="AETHER CONFIGURATION" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== CONTENT (SCROLLABLE) ===== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="30,20">
                <StackPanel>

                    <!-- ===== AI SETTINGS ===== -->
                    <TextBlock Text="AI CONFIGURATION" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                    <!-- API Key -->
                    <TextBlock Text="API Key" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4"/>
                    <Border Background="{StaticResource BgCardBrush}" 
                            BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1" 
                            CornerRadius="6" Padding="10,8">
                        <TextBox x:Name="ApiKeyBox" Background="Transparent" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 BorderThickness="0" FontSize="13"/>
                    </Border>
                    <TextBlock Text="ℹ Tip: Can also be set securely via the GROQ_API_KEY environment variable." 
                               FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>

                    <!-- Model -->
                    <TextBlock Text="AI Model" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,4"/>
                    <Border Background="{StaticResource BgCardBrush}" 
                            BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1" 
                            CornerRadius="6" Padding="10,4">
                        <ComboBox x:Name="ModelCombo" Background="Transparent" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0" FontSize="13">
                            <ComboBoxItem Content="openai/gpt-oss-120b"/>
                            <ComboBoxItem Content="openai/gpt-oss-20b"/>
                            <ComboBoxItem Content="qwen/qwen3.8-27b"/>
                            <ComboBoxItem Content="llama-3.3-70b-versatile"/>
                        </ComboBox>
                    </Border>

                    <!-- Personality -->
                    <TextBlock Text="AETHER Personality (System Prompt)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,4"/>
                    <Border Background="{StaticResource BgCardBrush}" 
                            BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1" 
                            CornerRadius="6" Padding="10,8">
                        <TextBox x:Name="PromptBox" Background="Transparent" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 BorderThickness="0" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="100" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <!-- ===== VOICE SETTINGS ===== -->
                    <TextBlock Text="VOICE CONFIGURATION" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,25,0,10"/>

                    <!-- Voice Gender -->
                    <TextBlock Text="Voice Gender" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4"/>
                    <Border Background="{StaticResource BgCardBrush}" 
                            BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1" 
                            CornerRadius="6" Padding="10,4">
                        <ComboBox x:Name="VoiceCombo" Background="Transparent" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0" FontSize="13">
                            <ComboBoxItem Content="British Male (AETHER)"/>
                            <ComboBoxItem Content="American Male"/>
                            <ComboBoxItem Content="British Female"/>
                            <ComboBoxItem Content="Hindi Male"/>
                            <ComboBoxItem Content="Hindi Female"/>
                        </ComboBox>
                    </Border>

                    <!-- Speech Rate -->
                    <TextBlock Text="Speech Rate" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="RateSlider" 
                                Minimum="-5" Maximum="5" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Foreground="{StaticResource AccentCyanBrush}"
                                ValueChanged="RateSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="RateValue" Text="0" 
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Volume -->
                    <TextBlock Text="Volume" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="VolumeSlider" 
                                Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Foreground="{StaticResource AccentCyanBrush}"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="VolumeValue" Text="100" 
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ===== MEMORY ===== -->
                    <TextBlock Text="MEMORY" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,25,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ResetMemoryBtn" Content="🔄 RESET CONVERSATION"
                                Padding="15,8" Margin="0,0,10,0" Cursor="Hand"
                                Background="{StaticResource BgCardBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource AccentCyanBrush}"
                                BorderThickness="1" Click="ResetMemory_Click"/>
                        <Button x:Name="ForgetMemoryBtn" Content="🗑 FORGET EVERYTHING"
                                Padding="15,8" Cursor="Hand"
                                Background="{StaticResource BgCardBrush}"
                                Foreground="{StaticResource ErrorBrush}"
                                BorderBrush="{StaticResource ErrorBrush}"
                                BorderThickness="1" Click="ForgetMemory_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== FOOTER BUTTONS ===== -->
            <Border Grid.Row="3" Background="#88111827" 
                    BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="0,1,0,0"
                    Padding="30,15" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Padding="25,10" Margin="0,0,10,0" Cursor="Hand"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource TextDimBrush}" BorderThickness="1"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SaveBtn" Content="💾 SAVE &amp; APPLY" Padding="25,10" Cursor="Hand"
                            Background="{StaticResource AccentCyanBrush}" Foreground="#FF0A0E1A"
                            BorderThickness="0" FontWeight="Bold"
                            Click="SaveButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>