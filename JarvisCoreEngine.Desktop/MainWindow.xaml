<Window x:Class="JarvisCoreEngine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER Core Engine"
        Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowState="Normal"
        FontFamily="{StaticResource PrimaryFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="Window_Loaded">

    <!-- OUTER GLOW BORDER -->
    <Border CornerRadius="14"
            Background="{StaticResource JarvisBgGradient}"
            BorderBrush="{StaticResource AccentCyanBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#00E5FF"
                              BlurRadius="50"
                              ShadowDepth="0"
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid>

            <!-- ===== ANIMATED HOLOGRAM GRID (DYNAMIC) ===== -->
            <Rectangle IsHitTestVisible="False" Opacity="0.18">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" 
                                  Viewport="0,0,120,120" 
                                  ViewportUnits="Absolute"
                                  Stretch="None">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#00E5FF" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,120"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="120,0"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                        <DrawingBrush.Transform>
                            <TranslateTransform x:Name="GridTransform" X="0" Y="0"/>
                        </DrawingBrush.Transform>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="GridTransform"
                                                 Storyboard.TargetProperty="X"
                                                 From="0" To="120"
                                                 Duration="0:0:8"/>
                                <DoubleAnimation Storyboard.TargetName="GridTransform"
                                                 Storyboard.TargetProperty="Y"
                                                 From="0" To="120"
                                                 Duration="0:0:8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>

            <!-- ===== FLOATING PARTICLES ===== -->
            <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" Opacity="0.6" ClipToBounds="True">
                <Ellipse Width="3" Height="3" Fill="#00E5FF" Canvas.Left="150" Canvas.Top="200">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="2" Height="2" Fill="#00E5FF" Canvas.Left="400" Canvas.Top="500">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:18" BeginTime="0:0:3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="4" Height="4" Fill="#00E5FF" Canvas.Left="800" Canvas.Top="300">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:15" BeginTime="0:0:5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="3" Height="3" Fill="#00E5FF" Canvas.Left="1000" Canvas.Top="400">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:20" BeginTime="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="2" Height="2" Fill="#00FF88" Canvas.Left="600" Canvas.Top="600">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:16" BeginTime="0:0:4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="3" Height="3" Fill="#00E5FF" Canvas.Left="1400" Canvas.Top="350">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:14" BeginTime="0:0:2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Width="2" Height="2" Fill="#00E5FF" Canvas.Left="1700" Canvas.Top="250">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="900" To="-20" Duration="0:0:17" BeginTime="0:0:6"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Canvas>

            <!-- ===== SCANLINE OVERLAY ===== -->
            <Rectangle IsHitTestVisible="False" Height="80" HorizontalAlignment="Stretch" VerticalAlignment="Top" Opacity="0.25">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00E5FF" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScanlineTransform" Y="-100"/>
                </Rectangle.RenderTransform>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ScanlineTransform" Storyboard.TargetProperty="Y" From="-100" To="1080" Duration="0:0:6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>

            <!-- ===== MAIN CONTENT ===== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE BAR -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="A.E.T.H.E.R — Advanced Executive Tactical &amp; Holographic Engine Resource"
                                   FontSize="11" FontWeight="Light"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="—" Width="36" Height="28" FontSize="14"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                            <Button x:Name="MaxButton" Content="▢" Width="36" Height="28" FontSize="11"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="MaxButton_Click" ToolTip="Maximize"/>
                            <Button Content="✕" Width="36" Height="28" FontSize="13"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- HEADER WITH HOLOGRAM RINGS + ARC REACTOR -->
                <Border Grid.Row="1" Background="#88111827"
                        BorderBrush="{StaticResource AccentCyanBrush}"
                        BorderThickness="0,0,0,1" Padding="30,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: JARVIS LOGO -->
                        <Grid Grid.Column="0" Width="220" Height="50">
                            <Ellipse Width="14" Height="14" Stroke="#00E5FF" StrokeThickness="1.5"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring1Scale" ScaleX="1" ScaleY="1" CenterX="7" CenterY="7"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleX" From="1" To="3" Duration="0:0:2"/>
                                                <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleY" From="1" To="3" Duration="0:0:2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <Ellipse Width="14" Height="14" Stroke="#00E5FF" StrokeThickness="1"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring2Scale" ScaleX="1" ScaleY="1" CenterX="7" CenterY="7"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1">
                                                <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleX" From="1" To="3" Duration="0:0:2"/>
                                                <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleY" From="1" To="3" Duration="0:0:2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <Ellipse Width="14" Height="14" Fill="{StaticResource AccentCyanBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="30" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:1.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AETHER" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="CORE ENGINE" FontSize="11" FontWeight="Light"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="14,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== CENTER: ARC REACTOR VOICE VISUALIZER ===== -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Height="60">

                            <!-- LEFT AUDIO BARS -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Rectangle x:Name="BarL1" Width="3" Height="10" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.5"/>
                                <Rectangle x:Name="BarL2" Width="3" Height="18" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.6"/>
                                <Rectangle x:Name="BarL3" Width="3" Height="25" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.7"/>
                                <Rectangle x:Name="BarL4" Width="3" Height="32" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.8"/>
                                <Rectangle x:Name="BarL5" Width="3" Height="40" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.9"/>
                            </StackPanel>

                            <!-- RIGHT AUDIO BARS -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Rectangle x:Name="BarR1" Width="3" Height="40" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.9"/>
                                <Rectangle x:Name="BarR2" Width="3" Height="32" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.8"/>
                                <Rectangle x:Name="BarR3" Width="3" Height="25" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.7"/>
                                <Rectangle x:Name="BarR4" Width="3" Height="18" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.6"/>
                                <Rectangle x:Name="BarR5" Width="3" Height="10" Fill="{StaticResource AccentCyanBrush}" Margin="2,0" RadiusX="2" RadiusY="2" Opacity="0.5"/>
                            </StackPanel>

                            <!-- ARC REACTOR ORB -->
                            <Grid Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!-- Outer Pulsing Ring -->
                                <Ellipse x:Name="OrbRing" Width="60" Height="60"
                                         Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.5" Opacity="0.4">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="OrbRingScale" ScaleX="1" ScaleY="1" CenterX="30" CenterY="30"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="OrbRingScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:2" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="OrbRingScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:2" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0.1" Duration="0:0:2" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- Middle Ring -->
                                <Ellipse Width="45" Height="45" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1" Opacity="0.6"/>

                                <!-- Core Orb -->
                                <Ellipse x:Name="OrbCore" Width="30" Height="30" Fill="{StaticResource AccentCyanBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="40" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.5" Duration="0:0:1.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- White Hot Center -->
                                <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="25" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                            </Grid>

                        </Grid>

                        <!-- RIGHT: TELEMETRY & STATUS -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- CPU BADGE -->
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CPU: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuText" Text="--%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM BADGE -->
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"
                                    BorderBrush="{StaticResource AccentCyanDimBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RAM: " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamText" Text="--%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ONLINE STATUS LIGHT -->
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00FF88" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ONLINE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CHAT AREA -->
                <Border Grid.Row="2" Background="Transparent" Padding="40,30">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChatPanel">
                            <Border Background="{StaticResource BgCardBrush}"
                                    CornerRadius="12" Padding="20,15" Margin="0,0,0,15"
                                    HorizontalAlignment="Left" MaxWidth="700">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="AETHER" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="System online, Commander. All services operational. How may I assist?"
                                               FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- GHOST MISSION PROGRESS BANNER -->
                <Border Grid.Row="3" x:Name="GhostBanner" Visibility="Collapsed" Background="#DD111827"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,1,0,0" Padding="35,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFFFC107" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="⚡ GHOST AGENT RUNNING: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="GhostStatusText" Grid.Column="1" Text="Executing autonomous directive..." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="5,0,15,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="OpenWorkspaceButton" Grid.Column="2" Content="📁 OPEN WORKSPACE" FontSize="11" FontWeight="Bold" Background="Transparent" Foreground="{StaticResource AccentCyanBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" Padding="12,4" Cursor="Hand" Click="OpenWorkspaceButton_Click"/>
                    </Grid>
                </Border>

                <!-- INPUT BAR -->
                <Border Grid.Row="4" Background="#88111827"
                        BorderBrush="{StaticResource AccentCyanBrush}"
                        BorderThickness="0,1,0,0" Padding="40,20" CornerRadius="0,0,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- TEXT INPUT -->
                        <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AccentCyanBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="15,10">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBox x:Name="InputBox" Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentCyanBrush}"
                                     BorderThickness="0" FontSize="14"
                                     VerticalAlignment="Center" KeyDown="InputBox_KeyDown"/>
                        </Border>

                        <!-- VISION BUTTON -->
                        <Button Grid.Column="1" x:Name="VisionButton" ToolTip="AETHER Vision (Alt+S) - Snap &amp; Analyze Screen"
                                Width="48" Height="48" Margin="10,0,0,0"
                                Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1.5"
                                Cursor="Hand" Click="VisionButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="VisionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock Text="👁" FontSize="20" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="VisionBorder" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- GHOST AGENT BUTTON -->
                        <Button Grid.Column="2" x:Name="GhostButton" ToolTip="Dispatch Autonomous Ghost Agent (Mission Mode)"
                                Width="48" Height="48" Margin="8,0,0,0"
                                Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5"
                                Cursor="Hand" Click="GhostButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="GhostBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFFFC107" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="GhostBorder" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- SEND BUTTON -->
                        <Button Grid.Column="3" x:Name="SendButton" Content="SEND"
                                FontWeight="Bold" FontSize="13" Foreground="#FF0A0E1A"
                                Background="{StaticResource AccentCyanBrush}" BorderThickness="0"
                                Padding="25,12" Margin="10,0,0,0" Cursor="Hand" Click="SendButton_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="25" ShadowDepth="0" Opacity="1"/>
                            </Button.Effect>
                        </Button>

                        <!-- MIC BUTTON -->
                        <Button Grid.Column="4" x:Name="MicButton"
                                Width="48" Height="48" Margin="8,0,0,0"
                                Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="2"
                                Cursor="Hand" Click="MicButton_Click" ToolTip="Click to speak">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MicBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <Path x:Name="MicIcon"
                                              Data="M 12 1 C 10.34 1 9 2.34 9 4 L 9 12 C 9 13.66 10.34 15 12 15 C 13.66 15 15 13.66 15 12 L 15 4 C 15 2.34 13.66 1 12 1 Z M 19 12 C 19 15.53 16.39 18.43 13 18.93 L 13 22 L 11 22 L 11 18.93 C 7.61 18.43 5 15.53 5 12 L 7 12 C 7 14.76 9.24 17 12 17 C 14.76 17 17 14.76 17 12 L 19 12 Z"
                                              Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Width="20" Height="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MicBorder" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>